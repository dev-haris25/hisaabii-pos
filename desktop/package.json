{
  "name": "hisabi-pos-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "sa.hisabi.pos",
    "productName": "Hisabi POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app-config.json",
      "icon.png"
    ],
    "icon": "icon.png",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    }
  }
}
