{
  "name": "hisabi-pos-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:offline-app": "bun --cwd offline-app install && bun --cwd offline-app run build",
    "dist": "bun run build:offline-app && electron-builder --win nsis",
    "dist:dir": "bun run build:offline-app && electron-builder --win dir",
    "postinstall": "electron-builder install-app-deps",
    "smoke:packaging": "node scripts/smoke-packaging-files.cjs"
  },
  "dependencies": {
    "@talha7k/zatca": "^0.13.0",
    "better-sqlite3": "^11.9.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "sa.hisabi.pos",
    "productName": "Hisabi POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app-config.json",
      "icon.png",
      "db/**/*",
      "local-api/**/*",
      "sync/**/*",
      "auth/**/*",
      "pos/**/*",
      "stock/**/*",
      "catalog/**/*",
      "zatca/**/*",
      "offline-app/dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "npmRebuild": true,
    "icon": "icon.png",
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hisabi POS"
    }
  }
}
