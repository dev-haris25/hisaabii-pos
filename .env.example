# Prisma — self-hosted Postgres. Without a separate pooler, DATABASE_URL and DIRECT_URL
# may be identical. Prisma CLI uses DIRECT_URL when set; otherwise DATABASE_URL (prisma.config.ts).
# If the DB password contains @ # / ? etc., URL-encode it (@ -> %40). Unencoded @ breaks the URL.
# Local dev default: `docker run -d --name hisabi-pos-postgres -e POSTGRES_DB=hisabi_pos
# -e POSTGRES_PASSWORD=yourpassword -p 5435:5432 -v hisabi-pos-postgres-data:/var/lib/postgresql/data postgres:16-alpine`
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5435/hisabi_pos"
DIRECT_URL="postgresql://postgres:yourpassword@localhost:5435/hisabi_pos"
DATABASE_SSL="false"

# Required in production (session cookie signing). Generate (Windows):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXT_PUBLIC_APP_NAME="Hisabi POS"
NEXT_PUBLIC_APP_URL=""
# Electron till app only (bun run desktop). Overrides the packaged live URL.
# Example local: HISABI_APP_URL="http://127.0.0.1:4517"
# Installer builds use desktop/app-config.json (https://pos.hisaabii.com) when unset.
HISABI_APP_URL=""
# Staging (develop branch): committed as .env.dev — copied by development.yml.
# Production (main): committed as .env.prod — copied by deploy.yml.
# Digits only, country code + number (e.g. 9665…). Leave empty to hide support link.
NEXT_PUBLIC_ZATCA_SUPPORT_WHATSAPP=""
# Dev/testing only: when "true", Windows receipt print uses A4 page size
# (80mm slip on A4). When "false" or unset, uses 80mm thermal page size.
NEXT_PUBLIC_RECEIPT_PRINT_A4="false"
PORT=4517
NODE_ENV=""

# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
# The client IP used by the rate limiter is the N-th entry from the right of
# X-Forwarded-For. 0 = no trusted proxy: forwarded headers are ignored and
# per-IP limits are skipped (per-email / per-table limits still apply).
# X-Real-IP is never used. Default 1.
TRUSTED_PROXY_HOPS="1"

# Absolute path for uploaded files (menu item images, company logos, etc.).
# Must be outside the project directory and not Git-tracked so deploys do not
# wipe them. Same code path in local/dev and production.
# Examples: C:\Users\you\hisabi-pos-uploads  |  /var/hisabi-pos-uploads
UPLOADS_DIR=""

# When "true", register email-verification OTP also accepts DUMMY_OTP (000000).
# OTP step is never skipped — real emailed OTPs still work. Controlled only by
# this flag (not NODE_ENV). Set to "false" on live if you do not want 000000.
HISABI_DEV_AUTOVERIFY_LOGIN="true"

# When "true", forgot-password OTP also accepts DUMMY_OTP (000000).
# Controlled only by this flag (not NODE_ENV).
HISABI_DEV_AUTOVERIFY_OTP="true"

# Gemini (server-side translation for invoice/onboarding EN → AR). Same vars as Hisabi.
# Get a key from Google AI Studio. Leave empty to disable bilingual suggestions.
TRANSLATION_API_KEY=""
# Default model matches Hisabi (override only if you need a different Gemini model).
GEMINI_TRANSLATION_MODEL="gemini-2.5-flash-lite"

# ZATCA e-invoicing (Fatoora Developer Portal sandbox by default)
ZATCA_ENABLED="true"
# sandbox | simulation | production — single-company app, still env-driven for parity with Hisabi.
ZATCA_ENV="sandbox"
# Client abort for Fatoora HTTP (Hisabi default 60s; production /core can be slow).
# ZATCA_API_TIMEOUT_MS="60000"

# SMTP (all outbound email — sign-up OTP, notifications)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Hisabi POS"

# Printer IP/port is NOT configured here — it's per-restaurant, stored on
# BusinessProfile (Settings → Receipt printer). Live printing uses QZ Tray
# on the POS PC (browser → localhost QZ → LAN printer). No QZ signing keys.

# Optional local print-bridge (separate process: `bun run print-bridge`)
# for ESC/POS dry-run files only. Cloud POS does not send jobs through it.
PRINT_BRIDGE_URL="http://127.0.0.1:3910"
PRINT_BRIDGE_PORT="3910"
# Shared secret (Bearer). Leave empty only for local dry-run. Generate:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PRINT_BRIDGE_SECRET=""
# When true, bridge writes ESC/POS bytes to a file instead of TCP 9100.
PRINT_BRIDGE_DRY_RUN="true"
# Optional override (default: <cwd>/tmp/print-dry-run)
# PRINT_BRIDGE_DRY_RUN_DIR=""
